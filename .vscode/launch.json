{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QueueCut: API (Spring Boot)",
      "type": "java",
      "request": "launch",
      "mainClass": "com.queuecut.api.QueueCutApplication",
      "projectName": "queuecut-api"
    },
    {
      "name": "QueueCut: Web (Vite)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal"
    }
  ]
}
