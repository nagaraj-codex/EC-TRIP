# QueueCut API environment template
# Copy to apps/api/.env for a local API run. Never commit the copied file.

SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/queuecut.db
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false

# Optional Google OAuth. Leave both blank to keep the integration unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Optional integrations. Leave blank for the no-cost local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
RESEND_API_KEY=
EMAIL_VERIFICATION_REQUIRED=false

# Reserved for the future protected data-ops screen; no current API consumer.
ADMIN_EMAILS=

