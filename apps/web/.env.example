# ==============================================================================
# QueueCut Web Environment Variables (Template)
# ==============================================================================
# Copy this file to .env and replace the values with your own.

# The base URL of the QueueCut backend API
VITE_API_BASE_URL=/api/v1

# The WebSocket path for live telemetry
VITE_WS_PATH=/ws/telemetry

# Mapbox public token for maps (must start with pk.)
VITE_MAPBOX_TOKEN=pk.your-public-mapbox-token
