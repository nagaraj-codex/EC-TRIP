# Project / app identity
APP_URL="http://localhost:8000"
ENVIRONMENT="development"

# AI / model services
GEMINI_API_KEY="MY_GEMINI_API_KEY"
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-2.5-flash"

# QueueCut intelligence providers
WEATHER_API_KEY=""
OPENWEATHER_API_KEY=""
BESTTIME_PUBLIC_KEY=""
BESTTIME_PRIVATE_KEY=""
ENABLE_MOCK_DATA="false"

# Optional app integrations
OLA_MAPS_API_KEY=""
MAPPLS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
LOCATIONIQ_API_KEY=""
GEOAPIFY_API_KEY=""
TOMTOM_API_KEY=""
RAPIDAPI_FUEL_KEY=""

# Authentication / security
SECRET_KEY="replace-with-a-random-secret"
JWT_SECRET="replace-with-a-random-jwt-secret"
JWT_REFRESH_SECRET="replace-with-a-random-refresh-secret"
RECAPTCHA_SECRET_KEY=""
CLOUDFLARE_TURNSTILE_SECRET=""

# Google OAuth 2.0 (Google Identity Platform)
# Required to enable Google sign-in in the UI.
# The OAuth client ID and secret must be created in Google Cloud Console.
# Callback URL must match the deployed backend URL exactly:
#   http://localhost:8000/api/v1/auth/google/callback
#   https://your-render-app.onrender.com/api/v1/auth/google/callback
#   https://your-project.vercel.app/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"
FRONTEND_URL="http://localhost:5173"

# Frontend runtime configuration
# For production on Vercel, set this to the deployed backend URL, eg. https://your-render-app.onrender.com/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Database / cache / runtime
DATABASE_URL="sqlite:///./queuecut.db"
REDIS_URL="redis://localhost:6379"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://your-vercel-app.vercel.app"

# Optional external service integrations
HUGGINGFACE_API_TOKEN=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
RESEND_API_KEY=""
BREVO_API_KEY=""
TELEGRAM_BOT_TOKEN=""
DISCORD_WEBHOOK_URL=""
GITHUB_TOKEN=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
