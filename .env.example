# ==============================================================================
# QueueCut Environment Variables (Template)
# ==============================================================================
# Copy this file to .env and replace the values with your own.
# DO NOT commit real secrets to this file!

# --- Application Core ---
SPRING_PROFILES_ACTIVE=local

# --- Frontend URLs & CORS ---
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false

# --- Database ---
# For SQLite (local profile):
SPRING_DATASOURCE_URL=jdbc:sqlite:./data/queuecut.db
# For PostgreSQL (docker/prod profile):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/queuecut
# SPRING_DATASOURCE_USERNAME=queuecut
# SPRING_DATASOURCE_PASSWORD=your_secure_db_password
# POSTGRES_DB=queuecut
# POSTGRES_USER=queuecut
# POSTGRES_PASSWORD=your_secure_db_password

# --- Redis (docker/prod profile) ---
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=your_secure_redis_password

# --- OAuth2: Google ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
